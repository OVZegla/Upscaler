{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Symp's Upscale",
  "version": "2.15.0",
  "identifier": "com.sympupscale.app",
  "build": {
    "frontendDist": "../renderer/out",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "npm run tauri:frontend",
    "beforeDevCommand": "npm run tauri:next-dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Symp's Upscale",
        "width": 1300,
        "height": 940,
        "minWidth": 600,
        "minHeight": 500,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/*",
      "resources/bin/*"
    ]
  },
  "plugins": {}
}
