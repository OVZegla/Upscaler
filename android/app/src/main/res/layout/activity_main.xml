<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header: the brand, and the one link to the credits the model's
         licence asks for. Nothing else to configure. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/about"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_title"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/dropZone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/drop_zone"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pick_title"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/pick_hint"
                android:textColor="@color/ink_2"
                android:textSize="16sp" />
        </LinearLayout>

        <com.sympupscale.nail.CompareView
            android:id="@+id/compare"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/working"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/workingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preparing"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="300dp"
                android:layout_height="12dp"
                android:layout_marginTop="18dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_track" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/sizeLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/ink_2"
        android:textSize="15sp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/secondary"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/primary"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
